<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ui.MainPage"
             Title="Gmailer">

    <Grid RowDefinitions="Auto, * , Auto"
          ColumnDefinitions="1*, 2*"
          Padding="10">
        
        <CollectionView x:Name="GroupList"
                        Grid.Row="1"
                        Grid.Column="0"
                        SelectionMode="Single"
                        SelectionChanged="OnGroupSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding Domain}"
                           FontAttributes="Bold"
                           Padding="10,5" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Right panel: emails -->
        <CollectionView x:Name="EmailList"
                        Grid.Row="1"
                        Grid.Column="1"
                        SelectionMode="Multiple">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding Subject}"
                           Padding="10,5" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Delete button -->
        <Button x:Name="DeleteBtn"
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Text="Delete Selected"
                Clicked="OnDeleteClicked"
                HorizontalOptions="Fill" />
    </Grid>
</ContentPage>