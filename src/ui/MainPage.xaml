<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:ui.Views"
             x:Class="ui.MainPage"
             Title="Gmailer">

    <AbsoluteLayout>

        <Grid x:Name="MainGrid"
              RowDefinitions="Auto,*,Auto"
              ColumnDefinitions="1*,2*"
              Padding="20"
              ColumnSpacing="20"
              RowSpacing="15"
              AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All">

            <Grid Grid.Row="0"
                  Grid.ColumnSpan="2"
                  ColumnDefinitions="Auto,Auto,*,Auto"
                  Margin="0,0,0,10">

                <VerticalStackLayout Grid.Column="0"
                                     Spacing="4"
                                     Margin="0,0,20,0">
                    <Picker x:Name="LabelPicker"
                            Title="Select Label"
                            WidthRequest="200"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedIndexChanged="OnLabelChanged"
                            BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2D2D2D}"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            FontSize="14"
                            FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="6">
                        <CheckBox x:Name="ListOnlyCheckBox" CheckedChanged="OnListOnlyChanged" />
                        <Label Text="List only" VerticalOptions="Center" FontSize="12" TextColor="Gray" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <Label x:Name="LastSyncLabel"
                       Grid.Column="1"
                       Text="Last Sync: Never"
                       VerticalOptions="Center"
                       TextColor="Gray"
                       FontSize="12"
                       Margin="0,0,20,0" />

                <Grid Grid.Column="2" />

                <Frame Grid.Column="3"
                       HasShadow="True"
                       Padding="0"
                       CornerRadius="8"
                       VerticalOptions="Center"
                       WidthRequest="160">

                    <Button x:Name="SyncBtn"
                            Text="Sync with Gmail"
                            Clicked="OnSyncClicked"
                            BackgroundColor="#E53935"
                            TextColor="White"
                            FontAttributes="Bold"
                            Padding="14,10"
                            CornerRadius="8"/>
                </Frame>

            </Grid>

            <views:GroupListView x:Name="GroupPanel"
                                 Grid.Row="1"
                                 Grid.Column="0"
                                 BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1E1E1E}"
                                 Margin="0,0,10,0"
                                 Padding="8" />

            <Border StrokeShape="RoundRectangle 8"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252525}"
                    Grid.Row="1"
                    Grid.Column="1">
                <views:EmailListView x:Name="EmailPanel"/>
            </Border>

            <Grid Grid.Row="2"
                  Grid.ColumnSpan="2"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="10"
                  Margin="0,10,0,0">

                <Button x:Name="ArchiveBtn"
                        Grid.Column="0"
                        Text="Archive Selected"
                        Clicked="OnArchiveClicked"
                        IsEnabled="False"
                        HorizontalOptions="Fill"
                        BackgroundColor="#26A69A"
                        TextColor="White"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        Padding="14,10" />

                <Button x:Name="DeleteBtn"
                        Grid.Column="1"
                        Text="Delete Selected"
                        Clicked="OnDeleteClicked"
                        HorizontalOptions="Fill"
                        BackgroundColor="#B388FF"
                        TextColor="White"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        Padding="14,10" />

            </Grid>

        </Grid>

        <Grid x:Name="ProgressOverlay"
              BackgroundColor="#80000000"
              IsVisible="False"
              VerticalOptions="FillAndExpand"
              HorizontalOptions="FillAndExpand"
              AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All"
              ZIndex="10">

            <Frame Padding="20"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2C}"
                   BorderColor="#888"
                   CornerRadius="8"
                   HasShadow="True"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">

                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True" Color="#E53935" />
                    <Label x:Name="ProgressLabel"
                           Text="Syncing..."
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                </VerticalStackLayout>

            </Frame>
        </Grid>

    </AbsoluteLayout>
</ContentPage>
