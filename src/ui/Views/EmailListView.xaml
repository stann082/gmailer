<ContentView
    x:Class="ui.Views.EmailListView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="clr-namespace:core;assembly=core">
    
    <CollectionView x:Name="EmailList" SelectionMode="Multiple">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="core:Email"
                          xmlns:models="clr-namespace:ui.Models">
                <HorizontalStackLayout Spacing="8" Padding="8,4" VerticalOptions="Center">
                    <Label Text="{Binding Date}" FontAttributes="Bold" WidthRequest="130" />
                    <Label Text="{Binding Address}" TextColor="Gray" MaxLines="1" />
                    <Label Text="{Binding Subject}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           HorizontalOptions="FillAndExpand" />
                </HorizontalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentView>