<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ui.Views.GroupListView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="clr-namespace:core;assembly=core">

    <CollectionView x:Name="GroupList"
                    SelectionMode="Single"
                    SelectionChanged="OnGroupSelected">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="core:EmailGrouping">
                <HorizontalStackLayout Spacing="8" Padding="10,5">
                    <Label Text="{Binding Domain}" FontAttributes="Bold" />
                    <Label Text="{Binding Total}" TextColor="Gray" />
                </HorizontalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentView>